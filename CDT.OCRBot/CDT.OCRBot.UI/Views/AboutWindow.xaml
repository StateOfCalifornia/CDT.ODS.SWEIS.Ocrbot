<Window x:Class="CDT.OCRBot.UI.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About OCRBot"
        Height="370"
        Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False">

    <Border Background="White"
            CornerRadius="10"
            BorderBrush="#CFD8DC"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="3" Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="#2C3E50"
                    CornerRadius="10,10,0,0"
                    Padding="20,15">
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="ℹ️ About OCRBot"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="left"/>
                </StackPanel>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="20,20">
                <StackPanel>
                    <!-- Version Info -->
                    <TextBlock Text="Version Information"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#2C3E50"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="txtVersion"
                               Text="Version: 1.0.0"
                               FontSize="12"
                               Foreground="#546E7A"
                               Margin="0,0,0,15"/>

                    <!-- Description -->
                    <TextBlock Text="About"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#2C3E50"
                               Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="#546E7A"
                               LineHeight="20"
                               Margin="0,0,0,15">
                        <Run Text="OCRBot"/>
                 <LineBreak/>
                        <Run Text="California Department of Technology"/>
                        <LineBreak/>
                        <Run Text="Service Desk: (916) 464-4311"/>
                        <LineBreak/>
                        <Run Text="Using iText 9.5.0 © 2000–2025 iText Group NV (AGPL version)"/>
                        <LineBreak/>
                        <TextBlock x:Name="txtCopyright"
                                   FontSize="12"
                                   Foreground="#546E7A"
                                   Margin="0,0,0,0"/>
                                   </TextBlock>    
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2"
                    Background="#F5F5F5"
                    CornerRadius="0,0,10,10"
                    Padding="20,15">
                <Button x:Name="btnClose"
                        Content="Close"
                        Width="100"
                        Height="36"
                        Click="BtnClose_Click"
                        HorizontalAlignment="Right"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        FontSize="12"
                        FontWeight="SemiBold">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    CornerRadius="6"
                                    Background="#43A047"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#388E3C"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#2E7D32"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>
