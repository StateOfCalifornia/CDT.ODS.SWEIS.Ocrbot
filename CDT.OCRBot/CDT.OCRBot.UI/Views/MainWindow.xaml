<Window x:Class="CDT.OCRBot.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OCRBot - PDF OCR Processing"
        Height="800"
        Width="1100"
        MinHeight="800"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F5F7FA"
        Icon="/Resources/app_icon.ico">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0288D1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0277BD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#01579B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#BDC3C7"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="2" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Help Menu Item Style -->
        <Style x:Key="HelpMenuItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E3F2FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Gradient -->
        <Border Grid.Row="0" Padding="25,15">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#2C3E50" Offset="0"/>
                    <GradientStop Color="#34495E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo and Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <StackPanel>
                        <TextBlock Text="OCRBot"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="PDF OCR Processing"
                                   FontSize="12"
                                   Foreground="#BDC3C7"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Header Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnHelp"
                            Content="❓ Help"
                            Width="95"
                            Height="38"
                            Margin="0,0,8,0"
                            Click="BtnHelp_Click"
                            Style="{StaticResource ModernButtonStyle}"
                            Background="#546E7A"
                            ToolTip="View Help, User Guide and FAQs"/>

                    <Button x:Name="btnViewLogs"
                            Content="📋 Logs"
                            Width="95"
                            Height="38"
                            Margin="0,0,8,0"
                            Click="BtnViewLogs_Click"
                            Style="{StaticResource ModernButtonStyle}"
                            Background="#607D8B"
                            ToolTip="View Application Logs"/>

                    <Button x:Name="btnSettings"
                            Content="⚙️ Settings"
                            Width="105"
                            Height="38"
                            Click="BtnSettings_Click"
                            Style="{StaticResource ModernButtonStyle}"
                            Background="#78909C"
                            ToolTip="Configure Azure Credentials and Default Folders"/>
                </StackPanel>

                <!-- Help Popup -->
                <Popup x:Name="helpPopup"
                       PlacementTarget="{Binding ElementName=btnHelp}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       VerticalOffset="5">
                    <Border Background="White"
                            BorderBrush="#CFD8DC"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="3" Opacity="0.25"/>
                        </Border.Effect>
                        <StackPanel Width="200">
                            <Button Content="📖  User Guide"
                                    Click="MenuUserGuide_Click"
                                    Style="{StaticResource HelpMenuItemStyle}"/>
                            <Button Content="❓  FAQs"
                                    Click="MenuFAQs_Click"
                                    Style="{StaticResource HelpMenuItemStyle}"/>
                            <Separator Margin="8,6" Background="#E0E0E0"/>
                            <Button Content="ℹ️  About"
                                    Click="MenuAbout_Click"
                                    Style="{StaticResource HelpMenuItemStyle}"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="25,20">
            <StackPanel>
                <!-- File Selection Section -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                    <StackPanel>
                        <!-- File Selection Header Row -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="📁 Select PDF Files"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#2C3E50"
                                       VerticalAlignment="Center"/>

                            <Button Grid.Column="2"
                                    x:Name="btnBrowseFiles"
                                    Content="📄 Choose Files"
                                    Height="36"
                                    Padding="20,8"
                                    Margin="0,0,10,0"
                                    Click="BtnBrowseFiles_Click"
                                    Style="{StaticResource ModernButtonStyle}"
                                    ToolTip="Browse and select PDF files from your computer"/>

                            <Button Grid.Column="3"
                                    x:Name="btnChooseFolder"
                                    Content="📂 Choose Folder"
                                    Height="36"
                                    Padding="20,8"
                                    Click="BtnChooseFolder_Click"
                                    Style="{StaticResource ModernButtonStyle}"
                                    ToolTip="Select all PDF files from a folder"/>
                        </Grid>

                        <!-- File List Grid -->
                        <Border BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                CornerRadius="6"
                                MinHeight="300"
                                MaxHeight="400">
                            <Grid>
                                <!-- Empty State -->
                                <StackPanel x:Name="emptyStatePanel"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Visibility="Visible">
                                    <TextBlock Text="📄"
                                               FontSize="48"
                                               HorizontalAlignment="Center"
                                               Foreground="#CFD8DC"
                                               Margin="0,0,0,10"/>
                                    <TextBlock Text="No files selected"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#90A4AE"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Use the buttons above to select PDF files"
                                               FontSize="12"
                                               Foreground="#607D8B"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- File List with Headers -->
                                <Grid x:Name="fileListPanel" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Column Headers -->
                                    <Border Grid.Row="0"
                                            Background="#F5F7FA"
                                            BorderBrush="#E0E0E0"
                                            BorderThickness="0,0,0,1"
                                            Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="File Name"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#546E7A"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="Status"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#546E7A"/>
                                            <TextBlock Grid.Column="3"
                                                       Text="Progress"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#546E7A"/>
                                            <TextBlock Grid.Column="4"
                                                       Text="Open"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#546E7A"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="5"
                                                       Text="Remove"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#546E7A"
                                                       HorizontalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- File List Items -->
                                    <ScrollViewer Grid.Row="1"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="fileListControl">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#E0E0E0"
                                                            BorderThickness="0,0,0,1"
                                                            Padding="12,10"
                                                            Background="Transparent"
                                                            Loaded="ProgressItem_Loaded">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#F8F9FA"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="2*"/>
                                                                <ColumnDefinition Width="30"/>
                                                                <ColumnDefinition Width="1.5*"/>
                                                                <ColumnDefinition Width="1.2*"/>
                                                                <ColumnDefinition Width="50"/>
                                                                <ColumnDefinition Width="50"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding Name}"
                                                                       FontSize="12"
                                                                       Foreground="#2C3E50"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding FullPath}"/>

                                                            <TextBlock Grid.Column="1"
                                                                       x:Name="iconTextBlock"
                                                                       Text="{Binding Icon}"
                                                                       FontSize="14"
                                                                       Foreground="{Binding StatusColor}"
                                                                       VerticalAlignment="Center"
                                                                       HorizontalAlignment="Center"/>

                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding Status}"
                                                                       FontSize="11"
                                                                       Foreground="{Binding StatusColor}"
                                                                       VerticalAlignment="Center"/>

                                                            <ProgressBar Grid.Column="3"
                                                                         x:Name="progressBar"
                                                                         Value="{Binding ProgressValue}"
                                                                         Height="6"
                                                                         Margin="0,0,10,0"
                                                                         Background="#E0E0E0"
                                                                         BorderThickness="0"
                                                                         VerticalAlignment="Center">
                                                                <ProgressBar.Style>
                                                                    <Style TargetType="ProgressBar">
                                                                        <Setter Property="Foreground" Value="#546E7A"/>
                                                                        <Style.Triggers>
                                                                            <!-- Green progress bar while processing (spinning icon) -->
                                                                            <DataTrigger Binding="{Binding Icon}" Value="⟳">
                                                                                <Setter Property="Foreground" Value="#43A047"/>
                                                                            </DataTrigger>
                                                                            <!-- Green when complete -->
                                                                            <DataTrigger Binding="{Binding Icon}" Value="✓">
                                                                                <Setter Property="Foreground" Value="#43A047"/>
                                                                            </DataTrigger>
                                                                            <!-- Red when failed -->
                                                                            <DataTrigger Binding="{Binding Icon}" Value="✕">
                                                                                <Setter Property="Foreground" Value="#E74C3C"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ProgressBar.Style>
                                                            </ProgressBar>

                                                            <Button Grid.Column="4"
                                                                    Content="📂"
                                                                    FontSize="16"
                                                                    Width="28"
                                                                    Height="28"
                                                                    Padding="0"
                                                                    Click="OpenFileFolder_Click"
                                                                    Tag="{Binding OutputPath}"
                                                                    Background="#FFF"
                                                                    BorderBrush="#E0E0E0"
                                                                    BorderThickness="1"
                                                                    Cursor="Hand"
                                                                    HorizontalAlignment="Center"
                                                                    ToolTip="Open file location"
                                                                    Visibility="{Binding OutputPathVisibility}">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Template">
                                                                            <Setter.Value>
                                                                                <ControlTemplate TargetType="Button">
                                                                                    <Border x:Name="border"
                                                                                            Background="{TemplateBinding Background}"
                                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                                            CornerRadius="4">
                                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                    </Border>
                                                                                    <ControlTemplate.Triggers>
                                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                                            <Setter TargetName="border" Property="Background" Value="#E3F2FD"/>
                                                                                            <Setter TargetName="border" Property="BorderBrush" Value="#0288D1"/>
                                                                                        </Trigger>
                                                                                    </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>

                                                                    <Button Grid.Column="5"
                                                                    Content="✕"
                                                                    FontSize="12"
                                                                    Width="24"
                                                                    Height="24"
                                                                    Padding="0"
                                                                    Click="RemoveFile_Click"
                                                                    Tag="{Binding FullPath}"
                                                                    IsEnabled="{Binding IsRemoveEnabled}"
                                                                    Background="#FFF"
                                                                    BorderBrush="#E0E0E0"
                                                                    BorderThickness="1"
                                                                    Foreground="#95A5A6"
                                                                    Cursor="Hand"
                                                                    HorizontalAlignment="Center"
                                                                    ToolTip="Remove this file">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Template">
                                                                            <Setter.Value>
                                                                                <ControlTemplate TargetType="Button">
                                                                                    <Border x:Name="border"
                                                                                            Background="{TemplateBinding Background}"
                                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                                            CornerRadius="4">
                                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                    </Border>
                                                                                    <ControlTemplate.Triggers>
                                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                                            <Setter TargetName="border" Property="Background" Value="#FFEBEE"/>
                                                                                            <Setter TargetName="border" Property="BorderBrush" Value="#E74C3C"/>
                                                                                            <Setter Property="Foreground" Value="#E74C3C"/>
                                                                                        </Trigger>
                                                                                        <Trigger Property="IsEnabled" Value="False">
                                                                                            <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                                                                                            <Setter Property="Foreground" Value="#CFD8DC"/>
                                                                                            <Setter Property="Cursor" Value="Arrow"/>
                                                                                        </Trigger>
                                                                                    </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- File Count Footer -->
                                    <Border Grid.Row="2"
                                            Background="#F5F7FA"
                                            BorderBrush="#E0E0E0"
                                            BorderThickness="0,1,0,0"
                                            Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       x:Name="txtFileCount"
                                                       Text="0 files selected (Maximum 4 files)"
                                                       FontSize="12"
                                                       Foreground="#546E7A"
                                                       VerticalAlignment="Center"/>

                                            <Button Grid.Column="1"
                                                    x:Name="btnClearAll"
                                                    Content="🗑️ Clear All"
                                                    Height="28"
                                                    Padding="12,0"
                                                    FontSize="11"
                                                    Click="ClearAll_Click"
                                                    Style="{StaticResource ModernButtonStyle}"
                                                    Background="#FF9800"
                                                    ToolTip="Remove all selected files"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Processing Options Section -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="⚙️ Processing Options"
                                   FontSize="16"
                                   
                                   Foreground="#2C3E50"
                                   VerticalAlignment="Center"
                                   Margin="0,0,30,0"/>

                        <CheckBox Grid.Column="1"
                                  x:Name="chkTextOnly"
                                  Content="📄 Text Only Mode"
                                  FontSize="13"
                                  Margin="0,0,30,0"
                                  VerticalAlignment="Center"
                                  ToolTip="Create a PDF with only extracted text (no images). Smaller file size, faster processing."/>

                        <CheckBox Grid.Column="2"
                                  x:Name="chkAddUATags"
                                  Content="♿ Auto Tag"
                                  FontSize="13"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed"
                                  ToolTip="Add semantic accessibility tags using AI. Creates PDF/UA compliant documents for screen readers."/>

                        <Button Grid.Column="4"
                                x:Name="btnProcess"
                                Content="Start Processing"
                                Height="38"
                                Padding="24,0"
                                FontSize="14"
                                Click="BtnProcess_Click"
                                IsEnabled="False">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                    <Setter Property="Background" Value="#43A047"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#388E3C"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="#BDC3C7"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="White" Padding="25,15">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="-2" Opacity="0.1" Direction="90"/>
            </Border.Effect>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="ℹ️"
                           FontSize="14"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="txtStatus"
                           Text="Ready to process files"
                           FontSize="13"
                           Foreground="#546E7A"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
